---
import { readFileSync, existsSync } from "node:fs";
import { resolve } from "node:path";
interface Props { name: string; size?: number; class?: string; stroke?: number }
const { name, size = 24, class: cls = "", stroke = 1.6 } = Astro.props;
const dir = resolve(process.cwd(), "node_modules/lucide-static/icons");
let file = resolve(dir, `${name}.svg`);
if (!existsSync(file)) file = resolve(dir, "sparkles.svg");
let svg = readFileSync(file, "utf8")
  .replace(/<!--[\s\S]*?-->/g, "")
  .replace(/width="24"/, `width="${size}"`)
  .replace(/height="24"/, `height="${size}"`)
  .replace(/stroke-width="2"/, `stroke-width="${stroke}"`)
  .replace(/class="[^"]*"/, `class="icon ${cls}" aria-hidden="true" focusable="false"`);
---
<Fragment set:html={svg} />
