---
import { site, waLink } from "../lib/config";
const c = site.contact || {};
const w = site.whatsappButton || {};
---
{c.whatsapp && (
  <div class="wa" data-wa>
    <div class="wa__bubble" data-wa-bubble role="status">
      <button type="button" class="wa__close" aria-label="Fechar" data-wa-close>×</button>
      <strong>{w.title || site.brand.name}</strong>
      <span>{w.text || "Olá! 👋 Como podemos ajudar? Fale com a nossa equipe."}</span>
    </div>
    <a class="wa__btn" href={waLink(c.whatsapp, c.whatsappMessage)} target="_blank" rel="noopener" aria-label="Conversar no WhatsApp">
      <span class="wa__pulse" aria-hidden="true"></span>
      <span class="wa__pulse wa__pulse--2" aria-hidden="true"></span>
      <svg viewBox="0 0 32 32" width="30" height="30" aria-hidden="true"><path fill="currentColor" d="M16.04 3C8.86 3 3.03 8.82 3.03 16c0 2.29.6 4.53 1.74 6.5L3 29l6.68-1.75A12.95 12.95 0 0 0 16.04 29C23.2 29 29 23.18 29 16S23.2 3 16.04 3Zm0 23.62c-1.98 0-3.92-.53-5.61-1.53l-.4-.24-3.97 1.04 1.06-3.87-.26-.4A10.6 10.6 0 0 1 5.4 16c0-5.86 4.77-10.63 10.64-10.63A10.63 10.63 0 0 1 26.64 16c0 5.87-4.76 10.62-10.6 10.62Zm5.83-7.96c-.32-.16-1.89-.93-2.18-1.04-.29-.1-.5-.16-.72.16-.21.32-.82 1.04-1 1.25-.19.21-.37.24-.69.08-.32-.16-1.35-.5-2.57-1.59-.95-.85-1.59-1.9-1.78-2.22-.18-.32-.02-.49.14-.65.14-.14.32-.37.48-.56.16-.18.21-.32.32-.53.1-.21.05-.4-.03-.56-.08-.16-.72-1.73-.98-2.37-.26-.62-.52-.54-.72-.55h-.61c-.21 0-.56.08-.85.4-.29.32-1.12 1.09-1.12 2.66s1.14 3.08 1.3 3.3c.16.2 2.25 3.44 5.46 4.82.76.33 1.36.53 1.82.68.77.24 1.46.21 2.01.13.61-.09 1.89-.77 2.16-1.52.26-.75.26-1.39.18-1.52-.08-.14-.29-.22-.61-.38Z"/></svg>
    </a>
    <span class="wa__label" aria-hidden="true">{w.label || "Fale conosco"}</span>
  </div>
)}
