---
// Imagem com fundo de reserva: se a foto não carregar, o bloco continua bonito
// (gradiente da paleta + textura), então o layout nunca "quebra".
import { img } from "../lib/config";
interface Props { src?: string; alt?: string; w?: number; class?: string; eager?: boolean; icon?: string }
const { src = "", alt = "", w = 1400, class: cls = "", eager = false } = Astro.props;
const url = img(src, w);
---
<div class={`media ${cls}`} data-media>
  <div class="media__fallback" aria-hidden="true"><span></span></div>
  {url && (
    <img src={url} alt={alt} loading={eager ? "eager" : "lazy"} decoding="async"
      onerror="this.style.display='none'" referrerpolicy="no-referrer" />
  )}
  <slot />
</div>
