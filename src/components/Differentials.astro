---
import { site, t } from "../lib/config";
import Heading from "./Heading.astro";
import Icon from "./Icon.astro";
const d = site.differentials || {};
const cta = d.cta || { label: "Fale com um especialista", href: "#contato" };
---
<section class="section diff" id="diferenciais" data-tone={t.tones.differentials}>
  <div class="orb orb--3" aria-hidden="true" data-parallax="0.15"></div>
  <div class="container diff__grid">
    <div class="diff__copy">
      <Heading eyebrow={d.eyebrow} title={d.title} highlight={d.highlight} subtitle={d.text} />
      <a class="btn btn--primary" href={cta.href} data-reveal data-magnetic>{cta.label}<Icon name="arrow-right" size={18} /></a>
    </div>
    <div class="diff__cards" data-reveal-group>
      {(d.items || []).map((it: any) => (
        <article class="diff-card" data-reveal data-spotlight>
          <span class="diff-card__icon"><Icon name={it.icon || "sparkles"} size={22} /></span>
          <h3>{it.title}</h3>
          <p>{it.description}</p>
        </article>
      ))}
    </div>
  </div>
</section>
